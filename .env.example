# Django Configuration
DJANGO_SECRET_KEY=change-me-in-production-use-a-strong-random-key-at-least-50-chars
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web

# Database (PostgreSQL)
DATABASE_URL=postgres://xaut_user:xaut_password@localhost:5432/xaut_db
# For Docker: postgres://xaut_user:xaut_password@postgres:5432/xaut_db

# Cache & Broker (Redis)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# For Docker: redis://redis:6379/0, etc.

# System Paths & Versions
ENGINE_VERSION=1.0.0
FEATURE_VERSION=feat-v1
ACTIVE_CONFIG_VERSION=cfg-2026-001

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json # 'json' or 'console'
