# Django Configuration
DJANGO_SECRET_KEY=change-me-in-production-use-a-strong-random-key-at-least-50-chars
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web

# Database (PostgreSQL)
DATABASE_URL=postgres://xaut_user:xaut_password@localhost:5432/xaut_db
# For Docker: postgres://xaut_user:xaut_password@postgres:5432/xaut_db

# Cache & Broker (Redis)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# For Docker: redis://redis:6379/0, etc.

# System Paths & Versions
ENGINE_VERSION=4.0.0
FEATURE_VERSION=feat-2026-v1
ACTIVE_CONFIG_VERSION=cfg-2026-v1

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console # 'json' or 'console'

# XAUUSD Live Monitoring Configuration (Example values only — explicit configuration required)
XAUUSD_LIVE_QUOTE_TTL_SECONDS=60
XAUUSD_QUOTE_STALE_SECONDS=45
XAUUSD_QUOTE_FUTURE_SKEW_SECONDS=60

# Institutional Spot Gold (XAU/USD) Data Feeds (Explicit provider credentials required for live/backfill)
XAUUSD_PRIMARY_FEED_URL=
XAUUSD_PRIMARY_API_KEY=
XAUUSD_SECONDARY_FEED_URL=
XAUUSD_SECONDARY_API_KEY=

# Alert Transports (Optional — disabled by default)
ALERT_WEBHOOK_URL=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

